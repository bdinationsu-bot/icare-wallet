.acard::before{content:'';position:absolute;top:16px;right:16px;width:32px;height:32px;border-radius:10px;background:linear-gradient(135deg,#ffe5e3,#ffd0cc)}
.acard .v{font-size:28px;font-weight:700;color:#1c1c1e;margin-bottom:4px;letter-spacing:-.8px}
