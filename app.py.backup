.btn-sm{padding:8px 14px;font-size:13px;width:auto;margin:0;border-radius:10px;display:inline-block;text-decoration:none;color:#fff;font-weight:600;transition:.15s;border:none;cursor:pointer;letter-spacing:-.2px}
.btn-sm:hover{opacity:.85;transform:translateY(-1px)}
'''

def flash_html():
    h = ''
    for cat, msg in session.pop('_flashes', []):
        cls = 'al-ok' if cat == 'success' else 'al-err'
        ico = '✓' if cat == 'success' else '⚠'
        h += f'<div class="alert {cls}">{ico} {msg}</div>'
    return h

def phone_page(body, nav_active='home'):
    nav = f'''
    <div class="nav">
      <a href="{url_for('wallet')}" class="{'on' if nav_active=='home' else ''}">
        <span class="ni">🏠</span><span>Home</span></a>
      <a href="{url_for('history')}" class="{'on' if nav_active=='history' else ''}">
        <span class="ni">📜</span><span>History</span></a>
      <a href="{url_for('transfer')}" class="fab">↑</a>
      <a href="{url_for('topup')}" class="{'on' if nav_active=='topup' else ''}">
        <span class="ni">💰</span><span>Top-up</span></a>
      <a href="{url_for('profile')}" class="{'on' if nav_active=='me' else ''}">
        <span class="ni">👤</span><span>Me</span></a>
    </div>'''
    return f'''<!doctype html>
<html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>iCare Wallet</title>
<style>{CSS}</style></head>
<body>
<div class="phone">
  <div class="notch"></div>
  <div class="status"><span>9:41</span><span>📶 🔋</span></div>
  <div class="screen">
    {flash_html()}
    {body}
  </div>
  {nav}
</div>
</body></html>'''

# ============ AUTH ============
@app.route('/')
def index():
    return redirect(url_for('wallet') if 'user_id' in session else url_for('login'))

@app.route('/register', methods=['GET', 'POST'])
def register():
    if request.method == 'POST':
        phone = request.form['phone'].strip()
        name = request.form['name'].strip()
        pin = request.form['pin'].strip()
        if not phone.startswith('09') or len(phone) < 9:
            flash('Phone နံပါတ် မှားနေပါ', 'error')
        elif not pin.isdigit() or not (4 <= len(pin) <= 6):
            flash('PIN က 4-6 digits ဖြစ်ရပါမယ်', 'error')
        else:
            conn = get_db()
            try:
                conn.execute("INSERT INTO users (phone,name,pin) VALUES (?,?,?)",
                             (phone, name, hash_pin(pin)))
                conn.commit()
                flash('✓ Wallet ဖွင့်ပြီးပါပြီ!', 'success')
                return redirect(url_for('login'))
            except sqlite3.IntegrityError:
                flash('Phone ရှိပြီးသား', 'error')
            finally:
                conn.close()

    body = f'''
    <div class="auth">
      <div class="auth-logo">
        <div class="lbox">❤</div>
        <h1>iCare Wallet</h1>
        <p>Secure • Trusted • Fast</p>
      </div>
      <div class="auth-form">
        <h3 style="font-size:18px;color:#fff;margin-bottom:4px">Account ဖွင့်ရန်</h3>
        <p style="font-size:13px;color:#737373">အချက်အလက်များ ဖြည့်ပါ</p>
        <form method="post">
          <label>📱 Phone Number</label>
          <input name="phone" placeholder="09xxxxxxxxx" required>
          <label>👤 အမည်</label>
          <input name="name" placeholder="Your name" required>
          <label>🔒 PIN (4-6 digits)</label>
          <input name="pin" type="password" placeholder="••••" required>
          <button class="btn">Account ဖွင့်မည်</button>
        </form>
        <p style="text-align:center;margin-top:20px;font-size:13px;color:#737373">
          Account ရှိပြီးသား?
          <a href="{url_for('login')}" style="color:#ef4444;font-weight:800;text-decoration:none">Login →</a>
        </p>
      </div>
    </div>'''
    return f'''<!doctype html><html><head><meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>iCare Wallet - Register</title><style>{CSS}</style></head>
    <body><div class="phone"><div class="notch"></div>
    <div class="status"><span>9:41</span><span>📶 🔋</span></div>
    <div class="screen">{flash_html()}{body}</div>
    </div></body></html>'''

@app.route('/login', methods=['GET', 'POST'])
def login():
    if request.method == 'POST':
        phone = request.form['phone'].strip()
        pin = request.form['pin'].strip()
        conn = get_db()
        u = conn.execute("SELECT * FROM users WHERE phone=? AND pin=?",
                         (phone, hash_pin(pin))).fetchone()
        conn.close()
        if u and u['is_active']:
            session['user_id'] = u['id']
            session['user_name'] = u['name']
            return redirect(url_for('wallet'))
        flash('Phone သို့မဟုတ် PIN မှားနေပါ', 'error')

    body = f'''
    <div class="auth">
      <div class="auth-logo">
        <div class="lbox">❤</div>
        <h1>iCare Wallet</h1>
        <p>Secure • Trusted • Fast</p>
      </div>
      <div class="auth-form">
        <h3 style="font-size:18px;color:#fff;margin-bottom:4px">ပြန်လည်ကြိုဆိုပါတယ်</h3>
        <p style="font-size:13px;color:#737373">Login ဝင်ရန်</p>
        <form method="post">
          <label>📱 Phone Number</label>
          <input name="phone" placeholder="09xxxxxxxxx" required>
          <label>🔒 PIN</label>
          <input name="pin" type="password" placeholder="••••" required>
          <button class="btn">ဝင်ရောက်မည်</button>
        </form>
        <p style="text-align:center;margin-top:20px;font-size:13px;color:#737373">
          Account မရှိဘူးလား?
          <a href="{url_for('register')}" style="color:#ef4444;font-weight:800;text-decoration:none">Register →</a>
        </p>
        <p style="text-align:center;margin-top:14px">
          <a href="{url_for('admin_login')}" style="font-size:12px;color:#525252;text-decoration:none">
          🛡️ Admin Login</a>
        </p>
      </div>
    </div>'''
    return f'''<!doctype html><html><head><meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>iCare Wallet - Login</title><style>{CSS}</style></head>
    <body><div class="phone"><div class="notch"></div>
    <div class="status"><span>9:41</span><span>📶 🔋</span></div>
    <div class="screen">{flash_html()}{body}</div>
    </div></body></html>'''

@app.route('/logout')
def logout():
    session.clear()
    return redirect(url_for('login'))

# ============ WALLET HOME ============
@app.route('/wallet')
@login_required
def wallet():
    conn = get_db()
    u = conn.execute("SELECT * FROM users WHERE id=?", (session['user_id'],)).fetchone()
    txns = conn.execute("SELECT * FROM transactions WHERE user_id=? ORDER BY id DESC LIMIT 5",
                        (session['user_id'],)).fetchall()
    sent = conn.execute("SELECT COALESCE(SUM(amount),0) FROM transactions WHERE user_id=? AND type='SEND'",
                        (session['user_id'],)).fetchone()[0]
    recv = conn.execute("SELECT COALESCE(SUM(amount),0) FROM transactions WHERE user_id=? AND type IN ('TOPUP','RECEIVE')",
                        (session['user_id'],)).fetchone()[0]
    conn.close()

    txn_rows = ''
    for t in txns:
        is_in = t['type'] in ('TOPUP', 'RECEIVE')
        cls = 'in' if is_in else 'out'
        bg = 'bg-in' if is_in else 'bg-out'
        sign = '+' if is_in else '-'
        icon = {'TOPUP': '💰', 'RECEIVE': '⬇️', 'WITHDRAW': '💸',
                'SEND': '📤', 'ADMIN_ADJUST': '⚙️'}.get(t['type'], '•')
        title = {'TOPUP': 'Top-up', 'RECEIVE': 'လက်ခံရရှိ', 'WITHDRAW': 'ထုတ်ယူ',
                 'SEND': 'လွှဲပို့', 'ADMIN_ADJUST': 'Admin Adjust'}.get(t['type'], t['type'])
        note = f" • {t['note'][:20]}" if t['note'] else ''
        txn_rows += f'''
        <div class="txn">
          <div class="av {bg}">{icon}</div>
          <div class="info">
            <div class="t">{title}</div>
            <div class="d">{t['created_at'][:16]}{note}</div>
          </div>
          <div class="amt {cls}">{sign}{t['amount']:,.0f}</div>
        </div>'''

    body = f'''
    <div class="balance-wrap">
      <div class="balance-card">
        <div class="bc-head">
          <div class="brand"><div class="logo">❤</div> iCare Wallet</div>
          <div class="dots">•••</div>
        </div>
        <div class="bc-label">လက်ကျန်ငွေ</div>
        <div class="bc-amount">{u['balance']:,.0f} <span style="font-size:18px">Ks</span></div>
        <div class="bc-user">👤 {u['name']} • {u['phone']}</div>
        <div class="bc-actions">
          <a href="{url_for('topup')}">💰 Top-up</a>
          <a href="{url_for('transfer')}">📤 လွှဲ</a>
        </div>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="v" style="color:#10b981">+{recv:,.0f}</div>
        <div class="l">ဝင်ငွေ</div>
      </div>
      <div class="stat">
        <div class="v" style="color:#ef4444">-{sent:,.0f}</div>
        <div class="l">ထွက်ငွေ</div>
      </div>
    </div>

    <div class="section">
      <div class="section-head"><h3>⚡ ဝန်ဆောင်မှုများ</h3></div>
      <div class="actions-grid">
        <a href="{url_for('topup')}" class="action">
          <div class="ico">💰</div><div class="lbl">Top-up</div></a>
        <a href="{url_for('transfer')}" class="action">
          <div class="ico">📤</div><div class="lbl">လွှဲ</div></a>
        <a href="{url_for('withdraw')}" class="action">
          <div class="ico">💸</div><div class="lbl">ထုတ်</div></a>
        <a href="{url_for('history')}" class="action">
          <div class="ico">📜</div><div class="lbl">History</div></a>
      </div>
    </div>

    <div class="section" style="padding-top:0">
      <div class="section-head">
        <h3>📋 မကြာသေးမီ ငွေလှုပ်ရှားမှု</h3>
        <a href="{url_for('history')}">အားလုံး →</a>
      </div>
      <div class="txn-list">
        {txn_rows or '<div style="padding:40px;text-align:center;color:#525252;font-size:13px">မှတ်တမ်း မရှိသေးပါ</div>'}
      </div>
    </div>
    '''
    return phone_page(body, 'home')

# ============ TOP-UP ============
@app.route('/topup', methods=['GET', 'POST'])
@login_required
def topup():
    if request.method == 'POST':
        amt = float(request.form['amount'])
        if amt <= 0:
            flash('ပမာណ် မှားနေပါ', 'error')
        else:
            conn = get_db()
            u = conn.execute("SELECT * FROM users WHERE id=?", (session['user_id'],)).fetchone()
            nb = u['balance'] + amt
            conn.execute("UPDATE users SET balance=? WHERE id=?", (nb, u['id']))
            conn.execute("INSERT INTO transactions (user_id,type,amount,balance_after,note) VALUES (?,?,?,?,?)",
                         (u['id'], 'TOPUP', amt, nb, request.form.get('note') or 'Top-up'))
            conn.commit(); conn.close()
            flash(f'✓ {amt:,.0f} Ks ဖြည့်ပြီးပါပြီ', 'success')
            return redirect(url_for('wallet'))

    body = f'''
    <div class="appbar">
      <a href="{url_for('wallet')}">←</a>
      <h2>💰 Top-up</h2>
    </div>
    <div class="form-wrap">
      <label>ဖြည့်မယ့် ပမာណ် (Ks)</label>
      <input name="amount" form="f" type="number" placeholder="0" required
        style="width:100%;padding:14px 16px;background:#1a1a1a;border:2px solid #262626;
        border-radius:14px;font-size:15px;color:#fff">
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px">
        <button type="button" onclick="document.querySelector('[name=amount]').value=5000"
          style="padding:12px;background:#1a1a1a;border:2px solid #262626;border-radius:10px;
          font-weight:800;color:#ef4444;cursor:pointer;transition:.2s">5K</button>
        <button type="button" onclick="document.querySelector('[name=amount]').value=10000"
          style="padding:12px;background:#1a1a1a;border:2px solid #262626;border-radius:10px;
          font-weight:800;color:#ef4444;cursor:pointer;transition:.2s">10K</button>
        <button type="button" onclick="document.querySelector('[name=amount]').value=20000"
          style="padding:12px;background:#1a1a1a;border:2px solid #262626;border-radius:10px;
          font-weight:800;color:#ef4444;cursor:pointer;transition:.2s">20K</button>
        <button type="button" onclick="document.querySelector('[name=amount]').value=50000"
          style="padding:12px;background:#1a1a1a;border:2px solid #262626;border-radius:10px;
          font-weight:800;color:#ef4444;cursor:pointer;transition:.2s">50K</button>
      </div>
      <form method="post" id="f">
        <label>Note</label>
        <input name="note" placeholder="Top-up">
        <button class="btn">ဖြည့်မည်</button>
      </form>
    </div>'''
    return phone_page(body, 'topup')

# ============ WITHDRAW ============
@app.route('/withdraw', methods=['GET', 'POST'])
@login_required
def withdraw():
    if request.method == 'POST':
        amt = float(request.form['amount'])
        conn = get_db()
        u = conn.execute("SELECT * FROM users WHERE id=?", (session['user_id'],)).fetchone()
        if amt <= 0:
            flash('ပမာណ် မှားနေပါ', 'error')
        elif amt > u['balance']:
            flash(f'Balance မလုံလောက်ပါ ({u["balance"]:,.0f} Ks)', 'error')
        else:
            nb = u['balance'] - amt
            conn.execute("UPDATE users SET balance=? WHERE id=?", (nb, u['id']))
            conn.execute("INSERT INTO transactions (user_id,type,amount,balance_after,note) VALUES (?,?,?,?,?)",
                         (u['id'], 'WITHDRAW', amt, nb, request.form.get('note') or 'Withdraw'))
            conn.commit(); conn.close()
            flash(f'✓ {amt:,.0f} Ks ထုတ်ပြီးပါပြီ', 'success')
            return redirect(url_for('wallet'))
        conn.close()

    body = f'''
    <div class="appbar"><a href="{url_for('wallet')}">←</a><h2>💸 Withdraw</h2></div>
    <div class="form-wrap">
      <form method="post">
        <label>ထုတ်မယ့် ပမာណ် (Ks)</label>
        <input name="amount" type="number" placeholder="0" required>
        <label>Note</label>
        <input name="note" placeholder="Withdraw">
        <button class="btn">ထုတ်မည်</button>
      </form>
    </div>'''
    return phone_page(body)

# ============ TRANSFER ============
@app.route('/transfer', methods=['GET', 'POST'])
@login_required
def transfer():
    if request.method == 'POST':
        to = request.form['to'].strip()
        amt = float(request.form['amount'])
        pin = request.form['pin'].strip()
        conn = get_db()
        me = conn.execute("SELECT * FROM users WHERE id=?", (session['user_id'],)).fetchone()
        target = conn.execute("SELECT * FROM users WHERE phone=?", (to,)).fetchone()
        if not target:
            flash('Account မတွေ့ပါ', 'error')
        elif target['id'] == me['id']:
            flash('ကိုယ့်ကိုယ်ကို လွှဲလို့မရပါ', 'error')
        elif me['pin'] != hash_pin(pin):
            flash('PIN မှားနေပါ', 'error')
        elif amt <= 0 or amt > me['balance']:
            flash('Balance မလုံလောက်ပါ', 'error')
        else:
            nb1 = me['balance'] - amt
            nb2 = target['balance'] + amt
            note = request.form.get('note') or 'Transfer'
            conn.execute("UPDATE users SET balance=? WHERE id=?", (nb1, me['id']))
            conn.execute("UPDATE users SET balance=? WHERE id=?", (nb2, target['id']))
            conn.execute("INSERT INTO transactions (user_id,type,amount,balance_after,note,related_user_id) VALUES (?,?,?,?,?,?)",
                         (me['id'], 'SEND', amt, nb1, f'→ {target["name"]}', target['id']))
            conn.execute("INSERT INTO transactions (user_id,type,amount,balance_after,note,related_user_id) VALUES (?,?,?,?,?,?)",
                         (target['id'], 'RECEIVE', amt, nb2, f'← {me["name"]}', me['id']))
            conn.commit(); conn.close()
            flash(f'✓ {target["name"]} ဆီ {amt:,.0f} Ks လွှဲပြီးပါပြီ', 'success')
            return redirect(url_for('wallet'))
        conn.close()

    body = f'''
    <div class="appbar"><a href="{url_for('wallet')}">←</a><h2>📤 ငွေလွှဲ</h2></div>
    <div class="form-wrap">
      <form method="post">
        <label>📱 လက်ခံမယ့်သူ Phone</label>
        <input name="to" placeholder="09xxxxxxxxx" required>
        <label>💵 ပမာណ် (Ks)</label>
        <input name="amount" type="number" placeholder="0" required>
        <label>🔒 PIN</label>
        <input name="pin" type="password" placeholder="••••" required>
        <label>Note</label>
        <input name="note" placeholder="Transfer">
        <button class="btn">လွှဲမည်</button>
      </form>
    </div>'''
    return phone_page(body)

