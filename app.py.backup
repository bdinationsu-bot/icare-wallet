# ============ ADMIN ============
def admin_page(title, body):
    return f'''<!doctype html><html><head><meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{title} - iCare Admin</title><style>{CSS}</style></head>
    <body><div class="admin-frame">
      <div class="admin-nav">
        <h1>🛡️ iCare Admin</h1>
        <div>
          <a href="{url_for('admin_dashboard')}">Dashboard</a>
          <a href="{url_for('admin_users')}">Users</a>
          <a href="{url_for('admin_transactions')}">Transactions</a>
          <a href="{url_for('admin_logout')}">Logout</a>
        </div>
      </div>
      <div class="admin-body">
        {flash_html()}
        {body}
      </div>
    </div></body></html>'''

@app.route('/admin/login', methods=['GET', 'POST'])
def admin_login():
    if request.method == 'POST':
        u = request.form['username']
        p = hashlib.sha256(request.form['password'].encode()).hexdigest()
        conn = get_db()
        a = conn.execute("SELECT * FROM admins WHERE username=? AND password=?", (u, p)).fetchone()
        conn.close()
        if a:
            session['is_admin'] = True
            return redirect(url_for('admin_dashboard'))
        flash('Credential မှားနေပါ', 'error')
    body = f'''
    <div style="max-width:420px;margin:60px auto;background:#1a1a1a;padding:32px;
      border-radius:20px;box-shadow:0 10px 40px rgba(220,38,38,.3);border:1px solid #262626">
      <div style="text-align:center;margin-bottom:24px">
        <div style="width:60px;height:60px;background:#fff;border-radius:18px;
          margin:0 auto 12px;display:flex;align-items:center;justify-content:center;
          font-size:30px;color:#dc2626;font-weight:900">❤</div>
        <h2 style="color:#fff;font-size:20px;font-weight:800">iCare Admin</h2>
        <p style="color:#737373;font-size:13px;margin-top:4px">Control Panel</p>
      </div>
      <form method="post">
        <label style="font-size:12px;color:#a3a3a3;font-weight:700;
          text-transform:uppercase;letter-spacing:.5px">Username</label>
        <input name="username" value="admin" style="width:100%;padding:14px;
          background:#111;border:2px solid #262626;border-radius:12px;margin:6px 0 14px;
          font-size:14px;color:#fff" required>
        <label style="font-size:12px;color:#a3a3a3;font-weight:700;
          text-transform:uppercase;letter-spacing:.5px">Password</label>
        <input name="password" type="password" style="width:100%;padding:14px;
          background:#111;border:2px solid #262626;border-radius:12px;margin:6px 0 20px;
          font-size:14px;color:#fff" required>
        <button class="btn">ဝင်ရောက်</button>
      </form>
      <p style="text-align:center;margin-top:16px;font-size:12px;color:#525252">
        Default: admin / admin123</p>
    </div>'''
    return admin_page('Login', body)

@app.route('/admin/logout')
def admin_logout():
    session.pop('is_admin', None)
    return redirect(url_for('admin_login'))

@app.route('/admin')
@admin_required
def admin_dashboard():
    conn = get_db()
    stats = {
        'users': conn.execute("SELECT COUNT(*) FROM users").fetchone()[0],
        'active': conn.execute("SELECT COUNT(*) FROM users WHERE is_active=1").fetchone()[0],
        'balance': conn.execute("SELECT COALESCE(SUM(balance),0) FROM users").fetchone()[0],
        'txns': conn.execute("SELECT COUNT(*) FROM transactions").fetchone()[0],
    }
    recent = conn.execute('''SELECT t.*, u.name, u.phone FROM transactions t
                             LEFT JOIN users u ON u.id=t.user_id
                             ORDER BY t.id DESC LIMIT 10''').fetchall()
    conn.close()
    rows = ''
    for t in recent:
        cls = 'b-in' if t['type'] in ('TOPUP','RECEIVE') else 'b-out'
        rows += f'''<tr>
          <td>{t['name'] or '-'}<br><span style="color:#737373;font-size:12px">{t['phone'] or ''}</span></td>
          <td><span class="badge {cls}">{t['type']}</span></td>
          <td><b style="color:#ef4444">{t['amount']:,.0f} Ks</b></td>
          <td>{t['created_at'][:16]}</td>
        </tr>'''
    body = f'''
    <div class="admin-stats">
      <div class="acard"><div class="v">{stats['users']}</div><div class="l">Total Users</div></div>
      <div class="acard"><div class="v">{stats['active']}</div><div class="l">Active</div></div>
      <div class="acard"><div class="v">{stats['balance']:,.0f}</div><div class="l">Total Balance</div></div>
      <div class="acard"><div class="v">{stats['txns']}</div><div class="l">Transactions</div></div>
    </div>
    <div class="admin-table">
      <table>
        <thead><tr><th>User</th><th>Type</th><th>Amount</th><th>Date</th></tr></thead>
        <tbody>{rows or '<tr><td colspan=4 style="text-align:center;padding:40px;color:#525252">No data</td></tr>'}</tbody>
      </table>
    </div>'''
    return admin_page('Dashboard', body)

@app.route('/admin/users')
@admin_required
def admin_users():
    conn = get_db()
    users = conn.execute("SELECT * FROM users ORDER BY id DESC").fetchall()
    conn.close()
    rows = ''
    for u in users:
        st = '<span class="badge b-in">Active</span>' if u['is_active'] else '<span class="badge b-out">Disabled</span>'
        tgl = 'Disable' if u['is_active'] else 'Enable'
        tc = 'b-out' if u['is_active'] else 'b-in'
        rows += f'''<tr>
          <td>{u['id']}</td>
          <td><b>{u['name']}</b><br><span style="color:#737373;font-size:12px">{u['phone']}</span></td>
          <td><b style="color:#ef4444">{u['balance']:,.0f} Ks</b></td>
          <td>{st}</td>
          <td>
            <a href="{url_for('admin_user_detail', uid=u['id'])}" class="btn-sm"
              style="background:#dc2626">View</a>
            <a href="{url_for('admin_toggle_user', uid=u['id'])}" class="btn-sm badge {tc}">{tgl}</a>
          </td>
        </tr>'''
    body = f'''
    <div class="admin-table">
      <table>
        <thead><tr><th>ID</th><th>User</th><th>Balance</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>{rows or '<tr><td colspan=5 style="text-align:center;padding:40px;color:#525252">No users</td></tr>'}</tbody>
      </table>
    </div>'''
    return admin_page('Users', body)

@app.route('/admin/user/<int:uid>')
@admin_required
def admin_user_detail(uid):
    conn = get_db()
    u = conn.execute("SELECT * FROM users WHERE id=?", (uid,)).fetchone()
    if not u:
        conn.close()
        return redirect(url_for('admin_users'))
    txns = conn.execute("SELECT * FROM transactions WHERE user_id=? ORDER BY id DESC LIMIT 30", (uid,)).fetchall()
    conn.close()
    rows = ''
    for t in txns:
        cls = 'b-in' if t['type'] in ('TOPUP','RECEIVE') else 'b-out'
        rows += f'''<tr>
          <td><span class="badge {cls}">{t['type']}</span></td>
          <td>{t['amount']:,.0f} Ks</td>
          <td>{t['balance_after']:,.0f} Ks</td>
          <td>{t['note'] or '-'}</td>
          <td>{t['created_at'][:16]}</td>
        </tr>'''
    body = f'''
    <div class="admin-stats" style="grid-template-columns:1fr 1fr 1fr">
      <div class="acard"><div class="l">User</div><div class="v" style="font-size:18px">{u['name']}</div></div>
      <div class="acard"><div class="l">Phone</div><div class="v" style="font-size:18px">{u['phone']}</div></div>
      <div class="acard"><div class="l">Balance</div><div class="v">{u['balance']:,.0f} Ks</div></div>
    </div>
    <div class="admin-table" style="padding:24px;margin-bottom:20px">
      <h3 style="margin-bottom:16px;color:#fff">⚙️ Balance Adjust</h3>
      <form method="post" action="{url_for('admin_adjust_balance', uid=uid)}"
        style="display:flex;gap:12px;align-items:end;flex-wrap:wrap">
        <div style="flex:1;min-width:180px">
          <label style="font-size:12px;color:#a3a3a3;font-weight:700;
            text-transform:uppercase;letter-spacing:.5px">Amount (+/-)</label>
          <input name="amount" type="number" step="0.01" placeholder="5000 or -5000"
            style="width:100%;padding:12px;background:#111;border:2px solid #262626;
            border-radius:10px;margin-top:6px;color:#fff" required>
        </div>
        <div style="flex:2;min-width:220px">
          <label style="font-size:12px;color:#a3a3a3;font-weight:700;
            text-transform:uppercase;letter-spacing:.5px">Reason</label>
          <input name="reason" placeholder="Admin adjustment"
            style="width:100%;padding:12px;background:#111;border:2px solid #262626;
            border-radius:10px;margin-top:6px;color:#fff" required>
        </div>
        <button type="submit" class="btn-sm" style="padding:13px 24px;
          background:linear-gradient(135deg,#ef4444,#dc2626)">Adjust</button>
      </form>
    </div>
    <div class="admin-table">
      <table>
        <thead><tr><th>Type</th><th>Amount</th><th>Balance</th><th>Note</th><th>Date</th></tr></thead>
        <tbody>{rows or '<tr><td colspan=5 style="text-align:center;padding:40px;color:#525252">No data</td></tr>'}</tbody>
      </table>
    </div>
    <p style="margin-top:16px"><a href="{url_for('admin_users')}"
      style="color:#ef4444;text-decoration:none;font-weight:700">← Back to Users</a></p>'''
    return admin_page('User Detail', body)

@app.route('/admin/user/<int:uid>/adjust', methods=['POST'])
@admin_required
def admin_adjust_balance(uid):
    amt = float(request.form['amount'])
    reason = request.form['reason']
    conn = get_db()
    u = conn.execute("SELECT * FROM users WHERE id=?", (uid,)).fetchone()
    nb = u['balance'] + amt
    if nb < 0:
        flash('Balance အနုတ် ဖြစ်သွားပါမယ်', 'error')
    else:
        conn.execute("UPDATE users SET balance=? WHERE id=?", (nb, uid))
        conn.execute("INSERT INTO transactions (user_id,type,amount,balance_after,note) VALUES (?,?,?,?,?)",
                     (uid, 'ADMIN_ADJUST', amt, nb, reason))
        conn.commit()
        flash(f'✓ {amt:+,.0f} Ks adjust လုပ်ပြီးပါပြီ', 'success')
    conn.close()
    return redirect(url_for('admin_user_detail', uid=uid))

@app.route('/admin/user/<int:uid>/toggle')
@admin_required
def admin_toggle_user(uid):
    conn = get_db()
    u = conn.execute("SELECT * FROM users WHERE id=?", (uid,)).fetchone()
    conn.execute("UPDATE users SET is_active=? WHERE id=?", (0 if u['is_active'] else 1, uid))
    conn.commit(); conn.close()
    flash('✓ Status ပြောင်းပြီးပါပြီ', 'success')
    return redirect(url_for('admin_users'))

@app.route('/admin/transactions')
@admin_required
def admin_transactions():
    conn = get_db()
    txns = conn.execute('''SELECT t.*, u.name, u.phone FROM transactions t
                           LEFT JOIN users u ON u.id=t.user_id
                           ORDER BY t.id DESC LIMIT 100''').fetchall()
    conn.close()
    rows = ''
    for t in txns:
        cls = 'b-in' if t['type'] in ('TOPUP','RECEIVE') else 'b-out'
        rows += f'''<tr>
          <td>{t['id']}</td>
          <td>{t['name'] or '-'}<br><span style="color:#737373;font-size:12px">{t['phone'] or ''}</span></td>
          <td><span class="badge {cls}">{t['type']}</span></td>
          <td><b style="color:#ef4444">{t['amount']:,.0f} Ks</b></td>
          <td>{t['note'] or '-'}</td>
          <td>{t['created_at'][:16]}</td>
        </tr>'''
    body = f'''
    <div class="admin-table">
      <table>
        <thead><tr><th>ID</th><th>User</th><th>Type</th><th>Amount</th><th>Note</th><th>Date</th></tr></thead>
        <tbody>{rows or '<tr><td colspan=6 style="text-align:center;padding:40px;color:#525252">No data</td></tr>'}</tbody>
      </table>
    </div>'''
    return admin_page('Transactions', body)

