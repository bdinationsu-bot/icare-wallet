def flash_html():
    h = ''
    for cat, msg in session.pop('_flashes', []):
        cls = 'al-ok' if cat == 'success' else 'al-err'
        ico = '✓' if cat == 'success' else '⚠'
        h += f'<div class="alert {cls}">{ico} {msg}</div>'
    return h

def get_cart_count():
    return sum(session.get('cart', {}).values())

def phone_page(body, nav_active='home'):
    cart_count = get_cart_count()
    badge = f'<span class="badge-dot">{cart_count}</span>' if cart_count > 0 else ''
    nav = f'''
    <div class="nav">
      <a href="{url_for('wallet')}" class="{'on' if nav_active=='home' else ''}"><span class="ni">🏠</span><span>Home</span></a>
      <a href="{url_for('shop')}" class="{'on' if nav_active=='shop' else ''}"><span class="ni">🛍️</span><span>Shop</span></a>
      <a href="{url_for('cart')}" class="{'on' if nav_active=='cart' else ''}"><span class="ni">🛒</span>{badge}<span>Cart</span></a>
      <a href="{url_for('orders')}" class="{'on' if nav_active=='orders' else ''}"><span class="ni">📦</span><span>Orders</span></a>
      <a href="{url_for('profile')}" class="{'on' if nav_active=='me' else ''}"><span class="ni">👤</span><span>Me</span></a>
    </div>'''
    return f'''<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1"><title>iCare Wallet</title><style>{CSS}</style></head><body><div class="phone"><div class="notch"></div><div class="status"><span>9:41</span><span>📶 🔋</span></div><div class="screen">{flash_html()}{body}</div>{nav}</div></body></html>'''

@app.route('/')
def index():
    return redirect(url_for('wallet') if 'user_id' in session else url_for('login'))

@app.route('/register', methods=['GET', 'POST'])
def register():
    if request.method == 'POST':
        phone = request.form['phone'].strip(); name = request.form['name'].strip(); pin = request.form['pin'].strip()
        if not phone.startswith('09') or len(phone) < 9: flash('Phone နံပါတ် မှားနေပါ', 'error')
        elif not pin.isdigit() or not (4 <= len(pin) <= 6): flash('PIN က 4-6 digits', 'error')
        else:
            conn = get_db()
            try:
                conn.execute("INSERT INTO users (phone,name,pin) VALUES (?,?,?)", (phone, name, hash_pin(pin)))
                conn.commit(); flash('✓ Wallet ဖွင့်ပြီးပါပြီ!', 'success'); return redirect(url_for('login'))
            except sqlite3.IntegrityError: flash('Phone ရှိပြီးသား', 'error')
            finally: conn.close()
    body = f'''<div class="auth"><div class="auth-logo"><div class="lbox">❤</div><h1>iCare Wallet</h1><p>SECURE • TRUSTED • FAST</p></div>
    <div class="auth-form"><h3>Account ဖွင့်ရန်</h3><p style="font-size:13px;color:#8e8e93">အချက်အလက်များ ဖြည့်ပါ</p>
    <form method="post"><label>📱 Phone Number</label><input name="phone" placeholder="09xxxxxxxxx" required>
    <label>👤 အမည်</label><input name="name" placeholder="Your name" required>
    <label>🔒 PIN (4-6 digits)</label><input name="pin" type="password" placeholder="••••" required>
    <button class="btn">Account ဖွင့်မည်</button></form>
    <p style="text-align:center;margin-top:20px;font-size:13px;color:#8e8e93">Account ရှိပြီးသား? <a href="{url_for('login')}" style="color:#ff3b30;font-weight:700;text-decoration:none">Login →</a></p></div></div>'''
    return f'''<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>iCare - Register</title><style>{CSS}</style></head><body><div class="phone"><div class="notch"></div><div class="status"><span>9:41</span><span>📶 🔋</span></div><div class="screen">{flash_html()}{body}</div></div></body></html>'''

@app.route('/login', methods=['GET', 'POST'])
def login():
    if request.method == 'POST':
        phone = request.form['phone'].strip(); pin = request.form['pin'].strip()
        conn = get_db()
        u = conn.execute("SELECT * FROM users WHERE phone=? AND pin=?", (phone, hash_pin(pin))).fetchone()
        conn.close()
        if u and u['is_active']:
            session['user_id'] = u['id']; session['user_name'] = u['name']; return redirect(url_for('wallet'))
        flash('Phone သို့မဟုတ် PIN မှားနေပါ', 'error')
    body = f'''<div class="auth"><div class="auth-logo"><div class="lbox">❤</div><h1>iCare Wallet</h1><p>SECURE • TRUSTED • FAST</p></div>
    <div class="auth-form"><h3>ပြန်လည်ကြိုဆိုပါတယ်</h3><p style="font-size:13px;color:#8e8e93">Login ဝင်ရန်</p>
    <form method="post"><label>📱 Phone Number</label><input name="phone" placeholder="09xxxxxxxxx" required>
    <label>🔒 PIN</label><input name="pin" type="password" placeholder="••••" required>
    <button class="btn">ဝင်ရောက်မည်</button></form>
    <p style="text-align:center;margin-top:20px;font-size:13px;color:#8e8e93">Account မရှိဘူးလား? <a href="{url_for('register')}" style="color:#ff3b30;font-weight:700;text-decoration:none">Register →</a></p>
    <p style="text-align:center;margin-top:14px"><a href="{url_for('admin_login')}" style="font-size:12px;color:#c7c7cc;text-decoration:none">🛡️ Admin Login</a></p></div></div>'''
    return f'''<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>iCare - Login</title><style>{CSS}</style></head><body><div class="phone"><div class="notch"></div><div class="status"><span>9:41</span><span>📶 🔋</span></div><div class="screen">{flash_html()}{body}</div></div></body></html>'''

@app.route('/logout')
def logout():
    session.clear(); return redirect(url_for('login'))

@app.route('/wallet')
@login_required
def wallet():
    conn = get_db()
    u = conn.execute("SELECT * FROM users WHERE id=?", (session['user_id'],)).fetchone()
    txns = conn.execute("SELECT * FROM transactions WHERE user_id=? ORDER BY id DESC LIMIT 5", (session['user_id'],)).fetchall()
    sent = conn.execute("SELECT COALESCE(SUM(amount),0) FROM transactions WHERE user_id=? AND type='SEND'", (session['user_id'],)).fetchone()[0]
    recv = conn.execute("SELECT COALESCE(SUM(amount),0) FROM transactions WHERE user_id=? AND type IN ('TOPUP','RECEIVE')", (session['user_id'],)).fetchone()[0]
    conn.close()
    txn_rows = ''
    for t in txns:
        is_in = t['type'] in ('TOPUP','RECEIVE'); cls = 'in' if is_in else 'out'; bg = 'bg-in' if is_in else 'bg-out'
        sign = '+' if is_in else '-'
        icon = {'TOPUP':'💰','RECEIVE':'⬇️','WITHDRAW':'💸','SEND':'📤','ADMIN_ADJUST':'⚙️','PURCHASE':'🛍️'}.get(t['type'],'•')
        title = {'TOPUP':'Top-up','RECEIVE':'လက်ခံရရှိ','WITHDRAW':'ထုတ်ယူ','SEND':'လွှဲပို့','ADMIN_ADJUST':'Admin Adjust','PURCHASE':'ဝယ်ယူမှု'}.get(t['type'],t['type'])
        txn_rows += f'<div class="txn"><div class="av {bg}">{icon}</div><div class="info"><div class="t">{title}</div><div class="d">{t["created_at"][:16]}</div></div><div class="amt {cls}">{sign}{t["amount"]:,.0f}</div></div>'
    body = f'''<div class="balance-wrap"><div class="balance-card"><div class="bc-head"><div class="brand"><div class="logo">❤</div> iCare Wallet</div><div class="dots">•••</div></div>
    <div class="bc-label">လက်ကျန်ငွေ</div><div class="bc-amount">{u["balance"]:,.0f} <span style="font-size:18px">Ks</span></div>
    <div class="bc-user">👤 {u["name"]} • {u["phone"]}</div>
    <div class="bc-actions"><a href="{url_for('topup')}">💰 Top-up</a><a href="{url_for('transfer')}">📤 လွှဲ</a></div></div></div>
    <div class="stats"><div class="stat"><div class="v" style="color:#34c759">+{recv:,.0f}</div><div class="l">ဝင်ငွေ</div></div>
    <div class="stat"><div class="v" style="color:#ff3b30">-{sent:,.0f}</div><div class="l">ထွက်ငွေ</div></div></div>
    <div class="section"><div class="section-head"><h3>⚡ ဝန်ဆောင်မှုများ</h3></div>
    <div class="actions-grid">
    <a href="{url_for('shop')}" class="action"><div class="ico">🛍️</div><div class="lbl">Shop</div></a>
    <a href="{url_for('topup')}" class="action"><div class="ico">💰</div><div class="lbl">Top-up</div></a>
    <a href="{url_for('transfer')}" class="action"><div class="ico">📤</div><div class="lbl">လွှဲ</div></a>
    <a href="{url_for('history')}" class="action"><div class="ico">📜</div><div class="lbl">History</div></a></div></div>
    <div class="section" style="padding-top:0"><div class="section-head"><h3>📋 မကြာသေးမီ</h3><a href="{url_for('history')}">အားလုံး →</a></div>
    <div class="txn-list">{txn_rows or '<div style="padding:40px;text-align:center;color:#c7c7cc;font-size:13px">မှတ်တမ်း မရှိသေးပါ</div>'}</div></div>'''
    return phone_page(body, 'home')

@app.route('/topup', methods=['GET', 'POST'])
@login_required
def topup():
    if request.method == 'POST':
        amt = float(request.form['amount'])
        if amt <= 0: flash('ပမာဏ မှားနေပါ', 'error')
        else:
            conn = get_db()
            u = conn.execute("SELECT * FROM users WHERE id=?", (session['user_id'],)).fetchone()
            nb = u['balance'] + amt
            conn.execute("UPDATE users SET balance=? WHERE id=?", (nb, u['id']))
            conn.execute("INSERT INTO transactions (user_id,type,amount,balance_after,note) VALUES (?,?,?,?,?)", (u['id'],'TOPUP',amt,nb,request.form.get('note') or 'Top-up'))
            conn.commit(); conn.close(); flash(f'✓ {amt:,.0f} Ks ဖြည့်ပြီးပါပြီ', 'success'); return redirect(url_for('wallet'))
    body = f'<div class="appbar"><a href="{url_for("wallet")}">‹</a><h2>💰 Top-up</h2></div><div class="form-wrap"><form method="post"><label>ဖြည့်မယ့် ပမာဏ (Ks)</label><input name="amount" type="number" placeholder="0" required><label>Note</label><input name="note" placeholder="Top-up"><button class="btn">ဖြည့်မည်</button></form></div>'
    return phone_page(body)

@app.route('/withdraw', methods=['GET', 'POST'])
@login_required
def withdraw():
    if request.method == 'POST':
        amt = float(request.form['amount'])
        conn = get_db(); u = conn.execute("SELECT * FROM users WHERE id=?", (session['user_id'],)).fetchone()
        if amt <= 0: flash('ပမာဏ မှားနေပါ', 'error')
        elif amt > u['balance']: flash('Balance မလုံလောက်ပါ', 'error')
        else:
            nb = u['balance'] - amt
            conn.execute("UPDATE users SET balance=? WHERE id=?", (nb, u['id']))
            conn.execute("INSERT INTO transactions (user_id,type,amount,balance_after,note) VALUES (?,?,?,?,?)", (u['id'],'WITHDRAW',amt,nb,request.form.get('note') or 'Withdraw'))
            conn.commit(); conn.close(); flash(f'✓ {amt:,.0f} Ks ထုတ်ပြီးပါပြီ', 'success'); return redirect(url_for('wallet'))
        conn.close()
    body = f'<div class="appbar"><a href="{url_for("wallet")}">‹</a><h2>💸 Withdraw</h2></div><div class="form-wrap"><form method="post"><label>ထုတ်မယ့် ပမာဏ (Ks)</label><input name="amount" type="number" placeholder="0" required><label>Note</label><input name="note" placeholder="Withdraw"><button class="btn">ထုတ်မည်</button></form></div>'
    return phone_page(body)

@app.route('/transfer', methods=['GET', 'POST'])
@login_required
def transfer():
    if request.method == 'POST':
        to = request.form['to'].strip(); amt = float(request.form['amount']); pin = request.form['pin'].strip()
        conn = get_db()
        me = conn.execute("SELECT * FROM users WHERE id=?", (session['user_id'],)).fetchone()
        target = conn.execute("SELECT * FROM users WHERE phone=?", (to,)).fetchone()
        if not target: flash('Account မတွေ့ပါ', 'error')
        elif target['id'] == me['id']: flash('ကိုယ့်ကိုယ်ကို လွှဲလို့မရပါ', 'error')
        elif me['pin'] != hash_pin(pin): flash('PIN မှားနေပါ', 'error')
        elif amt <= 0 or amt > me['balance']: flash('Balance မလုံလောက်ပါ', 'error')
        else:
            nb1 = me['balance'] - amt; nb2 = target['balance'] + amt
            conn.execute("UPDATE users SET balance=? WHERE id=?", (nb1, me['id']))
            conn.execute("UPDATE users SET balance=? WHERE id=?", (nb2, target['id']))
            conn.execute("INSERT INTO transactions (user_id,type,amount,balance_after,note,related_user_id) VALUES (?,?,?,?,?,?)", (me['id'],'SEND',amt,nb1,f'→ {target["name"]}',target['id']))
            conn.execute("INSERT INTO transactions (user_id,type,amount,balance_after,note,related_user_id) VALUES (?,?,?,?,?,?)", (target['id'],'RECEIVE',amt,nb2,f'← {me["name"]}',me['id']))
            conn.commit(); conn.close(); flash(f'✓ {target["name"]} ဆီ {amt:,.0f} Ks လွှဲပြီးပါပြီ', 'success'); return redirect(url_for('wallet'))
        conn.close()
    body = f'<div class="appbar"><a href="{url_for("wallet")}">‹</a><h2>📤 ငွေလွှဲ</h2></div><div class="form-wrap"><form method="post"><label>📱 လက်ခံမယ့်သူ Phone</label><input name="to" placeholder="09xxxxxxxxx" required><label>💵 ပမာဏ (Ks)</label><input name="amount" type="number" placeholder="0" required><label>🔒 PIN</label><input name="pin" type="password" placeholder="••••" required><label>Note</label><input name="note" placeholder="Transfer"><button class="btn">လွှဲမည်</button></form></div>'
    return phone_page(body)

@app.route('/history')
@login_required
def history():
    conn = get_db()
    txns = conn.execute("SELECT * FROM transactions WHERE user_id=? ORDER BY id DESC LIMIT 50", (session['user_id'],)).fetchall()
    conn.close()
    rows = ''
    for t in txns:
        is_in = t['type'] in ('TOPUP','RECEIVE'); cls = 'in' if is_in else 'out'; bg = 'bg-in' if is_in else 'bg-out'
        sign = '+' if is_in else '-'
        icon = {'TOPUP':'💰','RECEIVE':'⬇️','WITHDRAW':'💸','SEND':'📤','ADMIN_ADJUST':'⚙️','PURCHASE':'🛍️'}.get(t['type'],'•')
        title = {'TOPUP':'Top-up','RECEIVE':'လက်ခံရရှိ','WITHDRAW':'ထုတ်ယူ','SEND':'လွှဲပို့','ADMIN_ADJUST':'Admin Adjust','PURCHASE':'ဝယ်ယူမှု'}.get(t['type'],t['type'])
        rows += f'<div class="txn"><div class="av {bg}">{icon}</div><div class="info"><div class="t">{title}</div><div class="d">{t["created_at"][:16]} {("• "+t["note"]) if t["note"] else ""}</div></div><div class="amt {cls}">{sign}{t["amount"]:,.0f}</div></div>'
    body = f'<div class="appbar"><a href="{url_for("wallet")}">‹</a><h2>📜 မှတ်တမ်း</h2></div><div class="section"><div class="txn-list">{rows or "<div style=&#39;padding:40px;text-align:center;color:#c7c7cc&#39;>မှတ်တမ်း မရှိသေးပါ</div>"}</div></div>'
    return phone_page(body, 'history')

@app.route('/shop')
@login_required
def shop():
    cat = request.args.get('cat', 'All')
    conn = get_db()
    cats = ['All'] + [r[0] for r in conn.execute("SELECT DISTINCT category FROM products WHERE is_active=1 AND category IS NOT NULL").fetchall()]
    if cat == 'All': products = conn.execute("SELECT * FROM products WHERE is_active=1 ORDER BY id DESC").fetchall()
    else: products = conn.execute("SELECT * FROM products WHERE is_active=1 AND category=? ORDER BY id DESC", (cat,)).fetchall()
    conn.close()
    cat_html = ''.join([f'<a href="{url_for("shop", cat=c)}" class="cat-chip {"on" if c==cat else ""}">{c}</a>' for c in cats])
    prod_html = ''
    for p in products:
        stock_tag = f'<div class="stock-tag">{p["stock"]}</div>' if p['stock'] > 0 else '<div class="stock-tag" style="background:rgba(255,59,48,.85)">ပြတ်</div>'
        prod_html += f'<a href="{url_for("product_detail", pid=p["id"])}" class="product"><div class="pimg">{p["image"]}{stock_tag}</div><div class="pbody"><div class="ptitle">{p["name"]}</div><div class="pcat">{p["category"] or "General"}</div><div class="pprice">{p["price"]:,.0f} <span style="font-size:11px;color:#8e8e93">Ks</span></div></div></a>'
    body = f'<div class="appbar"><a href="{url_for("wallet")}">‹</a><h2>🛍️ Shop</h2><a href="{url_for("cart")}" style="position:relative">🛒</a></div><div class="cat-scroll">{cat_html}</div><div class="product-grid">{prod_html or "<div style=&#39;padding:40px;text-align:center;color:#c7c7cc;grid-column:span 2&#39;>ပစ္စည်း မရှိသေးပါ</div>"}</div>'
    return phone_page(body, 'shop')

@app.route('/product/<int:pid>')
@login_required
def product_detail(pid):
    conn = get_db()
    p = conn.execute("SELECT * FROM products WHERE id=? AND is_active=1", (pid,)).fetchone()
    conn.close()
    if not p: return redirect(url_for('shop'))
    stock_status = f'လက်ကျန်: {p["stock"]} ခု' if p['stock'] > 0 else '❌ ပစ္စည်း ပြတ်နေပါ'
    disabled = 'disabled' if p['stock'] <= 0 else ''
    btn_style = 'opacity:.5;cursor:not-allowed' if p['stock'] <= 0 else ''
    body = f'''<div class="appbar"><a href="{url_for('shop')}">‹</a><h2>Product</h2><a href="{url_for('cart')}">🛒</a></div>
    <div class="product-detail"><div class="big-img">{p['image']}</div><h2>{p['name']}</h2>
    <div style="font-size:13px;color:#8e8e93">{p['category'] or 'General'}</div>
    <div class="price">{p['price']:,.0f} Ks</div>
    <div class="stock-info">📦 {stock_status}</div>
    <div class="desc">{p['description'] or 'No description'}</div>
    <form method="post" action="{url_for('add_to_cart', pid=pid)}">
    <div class="qty-box"><button type="button" onclick="qty(-1)">−</button><input type="number" name="qty" id="qty" value="1" min="1" max="{p['stock']}" readonly><button type="button" onclick="qty(1)">+</button></div>
    <button class="btn" {disabled} style="{btn_style}">🛒 Cart ထည့်မည်</button></form></div>
    <script>function qty(d){{var el=document.getElementById('qty');var v=parseInt(el.value)+d;if(v<1)v=1;if(v>{p['stock']})v={p['stock']};el.value=v;}}</script>'''
    return phone_page(body, 'shop')

@app.route('/cart/add/<int:pid>', methods=['POST'])
@login_required
def add_to_cart(pid):
    qty = int(request.form.get('qty', 1))
    conn = get_db(); p = conn.execute("SELECT * FROM products WHERE id=? AND is_active=1", (pid,)).fetchone(); conn.close()
    if not p or p['stock'] <= 0: flash('ပစ္စည်း မရနိုင်ပါ', 'error'); return redirect(url_for('shop'))
    cart = session.get('cart', {}); current = cart.get(str(pid), 0); cart[str(pid)] = min(current + qty, p['stock']); session['cart'] = cart
    flash('✓ Cart ထဲ ထည့်ပြီးပါပြီ', 'success'); return redirect(url_for('cart'))

@app.route('/cart')
@login_required
def cart():
    cart = session.get('cart', {}); conn = get_db()
    items = []; total = 0
    for pid, qty in cart.items():
        p = conn.execute("SELECT * FROM products WHERE id=?", (pid,)).fetchone()
        if p:
            sub = p['price'] * qty; total += sub; items.append({'p': p, 'qty': qty, 'sub': sub})
    conn.close()
    items_html = ''
    for it in items:
        items_html += f'<div class="cart-item"><div class="cimg">{it["p"]["image"]}</div><div class="cinfo"><div class="n">{it["p"]["name"]}</div><div class="p">{it["p"]["price"]:,.0f} Ks</div><div class="q">Qty: {it["qty"]} • Sub: {it["sub"]:,.0f} Ks</div></div><a href="{url_for("remove_from_cart", pid=it["p"]["id"])}" class="del">🗑️</a></div>'
    cart_content = f'<div style="padding:16px"><div style="background:#fff;border-radius:18px">{items_html}</div></div>' if items else '<div style="padding:80px 20px;text-align:center;color:#8e8e93"><div style="font-size:64px;margin-bottom:16px">🛒</div><div style="font-size:17px;font-weight:600">Cart ထဲ ဘာမှ မရှိပါ</div></div>'
    checkout_btn = f'<div class="order-summary"><div class="row"><span>စုစုပေါင်း ({sum(i["qty"] for i in items)} ခု)</span><span>{total:,.0f} Ks</span></div><div class="row"><span>Delivery</span><span style="color:#34c759">အခမဲ့</span></div><div class="row total"><span>ပေးချေရမည်</span><span class="val">{total:,.0f} Ks</span></div></div><div style="padding:0 16px 16px"><a href="{url_for("checkout")}" class="btn" style="display:block;text-decoration:none;text-align:center">💳 Wallet နဲ့ ပေးချေမည်</a></div>' if items else ''
    body = f'<div class="appbar"><a href="{url_for("shop")}">‹</a><h2>🛒 Cart</h2></div>{cart_content}{checkout_btn}'
    return phone_page(body, 'cart')

@app.route('/cart/remove/<int:pid>')
@login_required
def remove_from_cart(pid):
    cart = session.get('cart', {}); cart.pop(str(pid), None); session['cart'] = cart
    flash('✓ ဖျက်ပြီးပါပြီ', 'success'); return redirect(url_for('cart'))

@app.route('/checkout', methods=['GET', 'POST'])
@login_required
def checkout():
    cart = session.get('cart', {})
    if not cart: flash('Cart ထဲ ဘာမှ မရှိပါ', 'error'); return redirect(url_for('cart'))
    conn = get_db()
    u = conn.execute("SELECT * FROM users WHERE id=?", (session['user_id'],)).fetchone()
    items = []; total = 0
    for pid, qty in cart.items():
        p = conn.execute("SELECT * FROM products WHERE id=?", (pid,)).fetchone()
        if p: sub = p['price'] * qty; total += sub; items.append({'p': p, 'qty': qty, 'sub': sub})
    if request.method == 'POST':
        pin = request.form['pin'].strip()
        if u['pin'] != hash_pin(pin): flash('PIN မှားနေပါ', 'error')
        elif u['balance'] < total: flash(f'Balance မလုံလောက်ပါ ({u["balance"]:,.0f} Ks)', 'error')
        else:
            nb = u['balance'] - total; cur = conn.cursor()
            cur.execute("INSERT INTO orders (user_id,total,status,note) VALUES (?,?,?,?)", (u['id'], total, 'PENDING', 'Wallet purchase'))
            oid = cur.lastrowid
            for it in items:
                cur.execute("INSERT INTO order_items (order_id,product_id,product_name,price,quantity,subtotal) VALUES (?,?,?,?,?,?)", (oid, it['p']['id'], it['p']['name'], it['p']['price'], it['qty'], it['sub']))
                cur.execute("UPDATE products SET stock=stock-? WHERE id=?", (it['qty'], it['p']['id']))
            cur.execute("UPDATE users SET balance=? WHERE id=?", (nb, u['id']))
            cur.execute("INSERT INTO transactions (user_id,type,amount,balance_after,note) VALUES (?,?,?,?,?)", (u['id'], 'PURCHASE', total, nb, f'Order #{oid}'))
            conn.commit(); conn.close(); session['cart'] = {}
            flash(f'✓ Order #{oid} အောင်မြင်ပါပြီ!', 'success'); return redirect(url_for('orders'))
    conn.close()
    items_html = ''.join([f'<div class="cart-item"><div class="cimg">{it["p"]["image"]}</div><div class="cinfo"><div class="n">{it["p"]["name"]}</div><div class="q">{it["qty"]} × {it["p"]["price"]:,.0f}</div></div><div style="font-weight:700;color:#ff3b30">{it["sub"]:,.0f}</div></div>' for it in items])
    body = f'''<div class="appbar"><a href="{url_for('cart')}">‹</a><h2>💳 Checkout</h2></div>
    <div style="padding:16px"><div style="background:#fff;border-radius:18px">{items_html}</div></div>
    <div class="order-summary"><div class="row"><span>စုစုပေါင်း</span><span>{total:,.0f} Ks</span></div>
    <div class="row"><span>လက်ကျန်</span><span>{u['balance']:,.0f} Ks</span></div>
    <div class="row total"><span>ပေးချေရမည်</span><span class="val">{total:,.0f} Ks</span></div></div>
    <div class="form-wrap" style="padding-top:0"><form method="post"><label>🔒 PIN အတည်ပြု</label><input name="pin" type="password" placeholder="••••" required><button class="btn">ပေးချေမည်</button></form></div>'''
    return phone_page(body, 'cart')

@app.route('/orders')
@login_required
def orders():
    conn = get_db()
    orders_list = conn.execute("SELECT * FROM orders WHERE user_id=? ORDER BY id DESC", (session['user_id'],)).fetchall()
    orders_html = ''
    for o in orders_list:
        items = conn.execute("SELECT * FROM order_items WHERE order_id=?", (o['id'],)).fetchall()
        items_txt = '၊ '.join([f"{i['product_name']} ×{i['quantity']}" for i in items])
        status_map = {'PENDING':'⏳ စောင့်ဆိုင်း','CONFIRMED':'✅ အတည်ပြု','DELIVERED':'📦 ပို့ပြီး','CANCELLED':'❌ ပယ်ဖျက်'}
        orders_html += f'<div class="order-card"><div class="oh"><div class="oid">Order #{o["id"]}</div><div class="status-badge status-{o["status"]}">{status_map.get(o["status"],o["status"])}</div></div><div class="oitems">{items_txt}</div><div class="ofoot"><div style="font-size:12px;color:#8e8e93">{o["created_at"][:16]}</div><div class="ototal">{o["total"]:,.0f} Ks</div></div></div>'
    conn.close()
    body = f'<div class="appbar"><a href="{url_for("wallet")}">‹</a><h2>📦 မှာယူမှုများ</h2></div><div style="padding:16px">{orders_html or "<div style=&#39;padding:60px 20px;text-align:center;color:#8e8e93&#39;><div style=&#39;font-size:64px;margin-bottom:16px&#39;>📦</div><div style=&#39;font-size:17px;font-weight:600&#39;>မှာယူမှု မရှိသေးပါ</div></div>"}</div>'
    return phone_page(body, 'orders')

@app.route('/profile')
@login_required
def profile():
    conn = get_db()
    u = conn.execute("SELECT * FROM users WHERE id=?", (session['user_id'],)).fetchone()
    conn.close()
    body = f'''<div class="appbar"><a href="{url_for('wallet')}">‹</a><h2>👤 Profile</h2></div>
    <div class="section"><div style="background:#fff;border-radius:20px;padding:24px;text-align:center;box-shadow:0 1px 3px rgba(0,0,0,.04)">
    <div style="width:80px;height:80px;border-radius:50%;margin:0 auto 14px;background:linear-gradient(135deg,#ff453a,#d70015);color:#fff;font-size:36px;display:flex;align-items:center;justify-content:center;font-weight:700">{u['name'][0].upper()}</div>
    <h3 style="font-size:20px;color:#1c1c1e;font-weight:700">{u['name']}</h3>
    <p style="font-size:13px;color:#8e8e93;margin-top:4px">📱 {u['phone']}</p>
    <div style="margin-top:20px;padding:16px;background:#f2f2f7;border-radius:14px"><div style="font-size:12px;color:#8e8e93;font-weight:500">လက်ကျန်ငွေ</div>
    <div style="font-size:28px;font-weight:700;color:#ff3b30;margin-top:6px">{u['balance']:,.2f} Ks</div></div></div>
    <div style="margin-top:16px;background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.04)">
    <a href="{url_for('orders')}" style="display:flex;align-items:center;padding:18px;text-decoration:none;color:#1c1c1e;border-bottom:.5px solid #e5e5ea;gap:12px"><span style="font-size:20px">📦</span><span style="flex:1;font-weight:600">My Orders</span><span style="color:#c7c7cc">›</span></a>
    <a href="{url_for('history')}" style="display:flex;align-items:center;padding:18px;text-decoration:none;color:#1c1c1e;border-bottom:.5px solid #e5e5ea;gap:12px"><span style="font-size:20px">📜</span><span style="flex:1;font-weight:600">Transaction History</span><span style="color:#c7c7cc">›</span></a>
    <a href="{url_for('logout')}" style="display:flex;align-items:center;padding:18px;text-decoration:none;color:#ff3b30;gap:12px"><span style="font-size:20px">🚪</span><span style="flex:1;font-weight:600">Logout</span><span style="color:#c7c7cc">›</span></a></div></div>'''
    return phone_page(body, 'me')

def admin_page(title, body):
    return f'''<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title} - iCare Admin</title><style>{CSS}</style></head><body><div class="admin-frame"><div class="admin-nav"><h1>🛡️ iCare Admin</h1><div><a href="{url_for('admin_dashboard')}">Dashboard</a><a href="{url_for('admin_users')}">Users</a><a href="{url_for('admin_products')}">Products</a><a href="{url_for('admin_orders')}">Orders</a><a href="{url_for('admin_transactions')}">Transactions</a><a href="{url_for('admin_logout')}">Logout</a></div></div><div class="admin-body">{flash_html()}{body}</div></div></body></html>'''

@app.route('/admin/login', methods=['GET', 'POST'])
def admin_login():
    if request.method == 'POST':
        u = request.form['username']; p = hashlib.sha256(request.form['password'].encode()).hexdigest()
        conn = get_db(); a = conn.execute("SELECT * FROM admins WHERE username=? AND password=?", (u, p)).fetchone(); conn.close()
        if a: session['is_admin'] = True; return redirect(url_for('admin_dashboard'))
        flash('Credential မှားနေပါ', 'error')
    body = f'''<div style="max-width:420px;margin:60px auto;background:#fff;padding:32px;border-radius:20px;box-shadow:0 10px 40px rgba(0,0,0,.08)">
    <div style="text-align:center;margin-bottom:24px"><div style="width:60px;height:60px;background:linear-gradient(135deg,#ff453a,#d70015);border-radius:18px;margin:0 auto 12px;display:flex;align-items:center;justify-content:center;font-size:30px;color:#fff">❤</div>
    <h2 style="color:#1c1c1e;font-size:22px;font-weight:700">iCare Admin</h2><p style="color:#8e8e93;font-size:13px;margin-top:4px">Control Panel</p></div>
    <form method="post"><label style="font-size:13px;color:#8e8e93;font-weight:500">Username</label>
    <input name="username" value="admin" style="width:100%;padding:14px;background:#f2f2f7;border:none;border-radius:12px;margin:6px 0 14px;font-size:14px" required>
    <label style="font-size:13px;color:#8e8e93;font-weight:500">Password</label>
    <input name="password" type="password" style="width:100%;padding:14px;background:#f2f2f7;border:none;border-radius:12px;margin:6px 0 20px;font-size:14px" required>
    <button class="btn">ဝင်ရောက်</button></form>
    <p style="text-align:center;margin-top:16px;font-size:12px;color:#c7c7cc">Default: admin / admin123</p></div>'''
    return admin_page('Login', body)

@app.route('/admin/logout')
def admin_logout():
    session.pop('is_admin', None); return redirect(url_for('admin_login'))

@app.route('/admin')
@admin_required
def admin_dashboard():
    conn = get_db()
    stats = {'users': conn.execute("SELECT COUNT(*) FROM users").fetchone()[0], 'products': conn.execute("SELECT COUNT(*) FROM products WHERE is_active=1").fetchone()[0], 'orders': conn.execute("SELECT COUNT(*) FROM orders").fetchone()[0], 'revenue': conn.execute("SELECT COALESCE(SUM(total),0) FROM orders WHERE status!='CANCELLED'").fetchone()[0]}
    recent = conn.execute("SELECT o.*, u.name FROM orders o LEFT JOIN users u ON u.id=o.user_id ORDER BY o.id DESC LIMIT 5").fetchall()
    conn.close()
    rows = ''
    for o in recent:
        cls = 'b-info' if o['status']=='PENDING' else ('b-in' if o['status']=='DELIVERED' else 'b-out')
        rows += f'<tr><td>#{o["id"]}</td><td>{o["name"] or "-"}</td><td><b>{o["total"]:,.0f} Ks</b></td><td><span class="badge {cls}">{o["status"]}</span></td><td>{o["created_at"][:16]}</td></tr>'
    body = f'''<div class="admin-stats"><div class="acard"><div class="v">{stats["users"]}</div><div class="l">Users</div></div><div class="acard"><div class="v">{stats["products"]}</div><div class="l">Products</div></div><div class="acard"><div class="v">{stats["orders"]}</div><div class="l">Orders</div></div><div class="acard"><div class="v">{stats["revenue"]:,.0f}</div><div class="l">Revenue (Ks)</div></div></div>
    <div class="admin-table"><table><thead><tr><th>ID</th><th>User</th><th>Total</th><th>Status</th><th>Date</th></tr></thead><tbody>{rows or "<tr><td colspan=5 style='text-align:center;padding:40px;color:#c7c7cc'>No orders</td></tr>"}</tbody></table></div>'''
    return admin_page('Dashboard', body)

@app.route('/admin/users')
@admin_required
def admin_users():
    conn = get_db(); users = conn.execute("SELECT * FROM users ORDER BY id DESC").fetchall(); conn.close()
    rows = ''
    for u in users:
        st = '<span class="badge b-in">Active</span>' if u['is_active'] else '<span class="badge b-out">Disabled</span>'
        tgl = 'Disable' if u['is_active'] else 'Enable'; tc = 'b-out' if u['is_active'] else 'b-in'
        rows += f'<tr><td>{u["id"]}</td><td><b>{u["name"]}</b><br><span style="color:#8e8e93;font-size:12px">{u["phone"]}</span></td><td><b style="color:#ff3b30">{u["balance"]:,.0f} Ks</b></td><td>{st}</td><td><a href="{url_for("admin_user_detail", uid=u["id"])}" class="btn-sm" style="background:#007aff">View</a> <a href="{url_for("admin_toggle_user", uid=u["id"])}" class="btn-sm badge {tc}">{tgl}</a></td></tr>'
    body = f'<div class="admin-table"><table><thead><tr><th>ID</th><th>User</th><th>Balance</th><th>Status</th><th>Actions</th></tr></thead><tbody>{rows or "<tr><td colspan=5 style='text-align:center;padding:40px;color:#c7c7cc'>No users</td></tr>"}</tbody></table></div>'
    return admin_page('Users', body)

@app.route('/admin/user/<int:uid>')
@admin_required
def admin_user_detail(uid):
    conn = get_db(); u = conn.execute("SELECT * FROM users WHERE id=?", (uid,)).fetchone()
    if not u: conn.close(); return redirect(url_for('admin_users'))
    txns = conn.execute("SELECT * FROM transactions WHERE user_id=? ORDER BY id DESC LIMIT 30", (uid,)).fetchall(); conn.close()
    rows = ''
    for t in txns:
        cls = 'b-in' if t['type'] in ('TOPUP','RECEIVE') else 'b-out'
        rows += f'<tr><td><span class="badge {cls}">{t["type"]}</span></td><td>{t["amount"]:,.0f} Ks</td><td>{t["balance_after"]:,.0f} Ks</td><td>{t["note"] or "-"}</td><td>{t["created_at"][:16]}</td></tr>'
    body = f'''<div class="admin-stats" style="grid-template-columns:1fr 1fr 1fr"><div class="acard"><div class="l">User</div><div class="v" style="font-size:18px">{u["name"]}</div></div><div class="acard"><div class="l">Phone</div><div class="v" style="font-size:18px">{u["phone"]}</div></div><div class="acard"><div class="l">Balance</div><div class="v">{u["balance"]:,.0f} Ks</div></div></div>
    <div class="admin-table" style="padding:24px;margin-bottom:20px"><h3 style="margin-bottom:16px;color:#1c1c1e">⚙️ Balance Adjust</h3>
    <form method="post" action="{url_for('admin_adjust_balance', uid=uid)}" style="display:flex;gap:12px;align-items:end;flex-wrap:wrap">
    <div style="flex:1;min-width:180px"><label style="font-size:12px;color:#8e8e93;font-weight:600">Amount (+/-)</label><input name="amount" type="number" step="0.01" placeholder="5000 or -5000" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px" required></div>
    <div style="flex:2;min-width:220px"><label style="font-size:12px;color:#8e8e93;font-weight:600">Reason</label><input name="reason" placeholder="Adjustment" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px" required></div>
    <button type="submit" class="btn-sm" style="padding:13px 24px;background:linear-gradient(135deg,#ff453a,#d70015)">Adjust</button></form></div>
    <div class="admin-table"><table><thead><tr><th>Type</th><th>Amount</th><th>Balance</th><th>Note</th><th>Date</th></tr></thead><tbody>{rows or "<tr><td colspan=5 style='text-align:center;padding:40px;color:#c7c7cc'>No data</td></tr>"}</tbody></table></div>
    <p style="margin-top:16px"><a href="{url_for('admin_users')}" style="color:#ff3b30;text-decoration:none;font-weight:600">← Back to Users</a></p>'''
    return admin_page('User Detail', body)

@app.route('/admin/user/<int:uid>/adjust', methods=['POST'])
@admin_required
def admin_adjust_balance(uid):
    amt = float(request.form['amount']); reason = request.form['reason']
    conn = get_db(); u = conn.execute("SELECT * FROM users WHERE id=?", (uid,)).fetchone(); nb = u['balance'] + amt
    if nb < 0: flash('Balance အနုတ် ဖြစ်သွားပါမယ်', 'error')
    else:
        conn.execute("UPDATE users SET balance=? WHERE id=?", (nb, uid))
        conn.execute("INSERT INTO transactions (user_id,type,amount,balance_after,note) VALUES (?,?,?,?,?)", (uid,'ADMIN_ADJUST',amt,nb,reason))
        conn.commit(); flash(f'✓ {amt:+,.0f} Ks adjust ပြီးပါပြီ', 'success')
    conn.close(); return redirect(url_for('admin_user_detail', uid=uid))

@app.route('/admin/user/<int:uid>/toggle')
@admin_required
def admin_toggle_user(uid):
    conn = get_db(); u = conn.execute("SELECT * FROM users WHERE id=?", (uid,)).fetchone()
    conn.execute("UPDATE users SET is_active=? WHERE id=?", (0 if u['is_active'] else 1, uid)); conn.commit(); conn.close()
    flash('✓ Status ပြောင်းပြီးပါပြီ', 'success'); return redirect(url_for('admin_users'))

@app.route('/admin/products')
@admin_required
def admin_products():
    conn = get_db(); products = conn.execute("SELECT * FROM products ORDER BY id DESC").fetchall(); conn.close()
    rows = ''
    for p in products:
        st = '<span class="badge b-in">Active</span>' if p['is_active'] else '<span class="badge b-out">Hidden</span>'
        rows += f'<tr><td style="font-size:24px">{p["image"]}</td><td><b>{p["name"]}</b><br><span style="color:#8e8e93;font-size:12px">{p["category"] or "General"}</span></td><td><b style="color:#ff3b30">{p["price"]:,.0f} Ks</b></td><td>{p["stock"]}</td><td>{st}</td><td><a href="{url_for("admin_product_edit", pid=p["id"])}" class="btn-sm" style="background:#007aff">Edit</a> <a href="{url_for("admin_product_delete", pid=p["id"])}" class="btn-sm" style="background:#ff3b30" onclick="return confirm('ဖျက်မှာ သေချာလား?')">Del</a></td></tr>'
    body = f'<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px"><h2 style="color:#1c1c1e;font-weight:700">🏪 Products ({len(products)})</h2><a href="{url_for("admin_product_new")}" class="btn-sm" style="padding:12px 20px;background:linear-gradient(135deg,#ff453a,#d70015)">+ Product အသစ်</a></div><div class="admin-table"><table><thead><tr><th>Img</th><th>Product</th><th>Price</th><th>Stock</th><th>Status</th><th>Actions</th></tr></thead><tbody>{rows or "<tr><td colspan=6 style='text-align:center;padding:40px;color:#c7c7cc'>No products</td></tr>"}</tbody></table></div>'
    return admin_page('Products', body)

@app.route('/admin/product/new', methods=['GET', 'POST'])
@admin_required
def admin_product_new():
    if request.method == 'POST':
        conn = get_db()
        conn.execute("INSERT INTO products (name,description,price,stock,category,image) VALUES (?,?,?,?,?,?)", (request.form['name'], request.form['description'], float(request.form['price']), int(request.form['stock']), request.form['category'], request.form['image'] or '📦'))
        conn.commit(); conn.close(); flash('✓ Product ထည့်ပြီးပါပြီ', 'success'); return redirect(url_for('admin_products'))
    body = f'<div class="admin-table" style="padding:28px"><h2 style="margin-bottom:20px;color:#1c1c1e">🆕 Product အသစ်</h2><form method="post" style="display:grid;gap:14px;max-width:600px"><div><label style="font-size:12px;color:#8e8e93;font-weight:600">Name</label><input name="name" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px" required></div><div><label style="font-size:12px;color:#8e8e93;font-weight:600">Description</label><textarea name="description" rows="3" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px;font-family:inherit"></textarea></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:14px"><div><label style="font-size:12px;color:#8e8e93;font-weight:600">Price (Ks)</label><input name="price" type="number" step="1" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px" required></div><div><label style="font-size:12px;color:#8e8e93;font-weight:600">Stock</label><input name="stock" type="number" value="0" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px" required></div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:14px"><div><label style="font-size:12px;color:#8e8e93;font-weight:600">Category</label><input name="category" placeholder="Electronics" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px"></div><div><label style="font-size:12px;color:#8e8e93;font-weight:600">Icon</label><input name="image" value="📦" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px"></div></div><button type="submit" class="btn-sm" style="padding:14px;background:linear-gradient(135deg,#ff453a,#d70015);font-size:15px">သိမ်းမည်</button></form><p style="margin-top:16px"><a href="{url_for("admin_products")}" style="color:#ff3b30;text-decoration:none;font-weight:600">← Back</a></p></div>'
    return admin_page('New Product', body)

@app.route('/admin/product/<int:pid>/edit', methods=['GET', 'POST'])
@admin_required
def admin_product_edit(pid):
    conn = get_db(); p = conn.execute("SELECT * FROM products WHERE id=?", (pid,)).fetchone()
    if not p: conn.close(); return redirect(url_for('admin_products'))
    if request.method == 'POST':
        conn.execute("UPDATE products SET name=?,description=?,price=?,stock=?,category=?,image=?,is_active=? WHERE id=?", (request.form['name'], request.form['description'], float(request.form['price']), int(request.form['stock']), request.form['category'], request.form['image'], 1 if request.form.get('is_active') else 0, pid))
        conn.commit(); conn.close(); flash('✓ ပြင်ပြီးပါပြီ', 'success'); return redirect(url_for('admin_products'))
    conn.close()
    checked = 'checked' if p['is_active'] else ''
    body = f'<div class="admin-table" style="padding:28px"><h2 style="margin-bottom:20px;color:#1c1c1e">✏️ Edit: {p["name"]}</h2><form method="post" style="display:grid;gap:14px;max-width:600px"><div><label style="font-size:12px;color:#8e8e93;font-weight:600">Name</label><input name="name" value="{p["name"]}" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px" required></div><div><label style="font-size:12px;color:#8e8e93;font-weight:600">Description</label><textarea name="description" rows="3" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px;font-family:inherit">{p["description"] or ""}</textarea></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:14px"><div><label style="font-size:12px;color:#8e8e93;font-weight:600">Price</label><input name="price" type="number" value="{p["price"]}" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px" required></div><div><label style="font-size:12px;color:#8e8e93;font-weight:600">Stock</label><input name="stock" type="number" value="{p["stock"]}" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px" required></div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:14px"><div><label style="font-size:12px;color:#8e8e93;font-weight:600">Category</label><input name="category" value="{p["category"] or ""}" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px"></div><div><label style="font-size:12px;color:#8e8e93;font-weight:600">Icon</label><input name="image" value="{p["image"]}" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px"></div></div><label style="display:flex;align-items:center;gap:10px;font-size:14px"><input type="checkbox" name="is_active" {checked} style="width:20px;height:20px"> Active</label><button type="submit" class="btn-sm" style="padding:14px;background:linear-gradient(135deg,#ff453a,#d70015);font-size:15px">သိမ်းမည်</button></form><p style="margin-top:16px"><a href="{url_for("admin_products")}" style="color:#ff3b30;text-decoration:none;font-weight:600">← Back</a></p></div>'
    return admin_page('Edit Product', body)

@app.route('/admin/product/<int:pid>/delete')
@admin_required
def admin_product_delete(pid):
    conn = get_db(); conn.execute("DELETE FROM products WHERE id=?", (pid,)); conn.commit(); conn.close()
    flash('✓ ဖျက်ပြီးပါပြီ', 'success'); return redirect(url_for('admin_products'))

@app.route('/admin/orders')
@admin_required
def admin_orders():
    conn = get_db()
    orders_list = conn.execute("SELECT o.*, u.name, u.phone FROM orders o LEFT JOIN users u ON u.id=o.user_id ORDER BY o.id DESC").fetchall(); conn.close()
    rows = ''
    for o in orders_list:
        cls = 'b-info' if o['status']=='PENDING' else ('b-in' if o['status']=='DELIVERED' else 'b-out')
        rows += f'<tr><td>#{o["id"]}</td><td>{o["name"] or "-"}<br><span style="color:#8e8e93;font-size:12px">{o["phone"] or ""}</span></td><td><b>{o["total"]:,.0f} Ks</b></td><td><span class="badge {cls}">{o["status"]}</span></td><td>{o["created_at"][:16]}</td><td><a href="{url_for("admin_order_detail", oid=o["id"])}" class="btn-sm" style="background:#007aff">View</a></td></tr>'
    body = f'<div class="admin-table"><table><thead><tr><th>ID</th><th>User</th><th>Total</th><th>Status</th><th>Date</th><th></th></tr></thead><tbody>{rows or "<tr><td colspan=6 style='text-align:center;padding:40px;color:#c7c7cc'>No orders</td></tr>"}</tbody></table></div>'
    return admin_page('Orders', body)

@app.route('/admin/order/<int:oid>', methods=['GET', 'POST'])
@admin_required
def admin_order_detail(oid):
    conn = get_db()
    o = conn.execute("SELECT o.*, u.name, u.phone FROM orders o LEFT JOIN users u ON u.id=o.user_id WHERE o.id=?", (oid,)).fetchone()
    if not o: conn.close(); return redirect(url_for('admin_orders'))
    if request.method == 'POST':
        conn.execute("UPDATE orders SET status=? WHERE id=?", (request.form['status'], oid)); conn.commit()
        flash('✓ Status ပြောင်းပြီးပါပြီ', 'success'); conn.close(); return redirect(url_for('admin_order_detail', oid=oid))
    items = conn.execute("SELECT * FROM order_items WHERE order_id=?", (oid,)).fetchall(); conn.close()
    items_html = ''.join([f'<tr><td>{i["product_name"]}</td><td>{i["price"]:,.0f} Ks</td><td>{i["quantity"]}</td><td><b>{i["subtotal"]:,.0f} Ks</b></td></tr>' for i in items])
    options = ''.join([f'<option value="{s}" {"selected" if o["status"]==s else ""}>{s}</option>' for s in ['PENDING','CONFIRMED','DELIVERED','CANCELLED']])
    body = f'<div class="admin-stats" style="grid-template-columns:1fr 1fr 1fr"><div class="acard"><div class="l">Order</div><div class="v" style="font-size:20px">#{o["id"]}</div></div><div class="acard"><div class="l">Customer</div><div class="v" style="font-size:18px">{o["name"] or "-"}</div></div><div class="acard"><div class="l">Total</div><div class="v">{o["total"]:,.0f} Ks</div></div></div><div class="admin-table" style="padding:24px;margin-bottom:20px"><h3 style="margin-bottom:16px;color:#1c1c1e">📋 Status ပြောင်း</h3><form method="post" style="display:flex;gap:12px;align-items:end;flex-wrap:wrap"><div style="flex:1;min-width:200px"><label style="font-size:12px;color:#8e8e93;font-weight:600">Status</label><select name="status" style="width:100%;padding:12px;background:#f2f2f7;border:none;border-radius:10px;margin-top:6px;font-size:14px">{options}</select></div><button type="submit" class="btn-sm" style="padding:13px 24px;background:linear-gradient(135deg,#ff453a,#d70015)">Update</button></form></div><div class="admin-table" style="margin-bottom:20px"><table><thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Subtotal</th></tr></thead><tbody>{items_html}</tbody></table></div><p><a href="{url_for("admin_orders")}" style="color:#ff3b30;text-decoration:none;font-weight:600">← Back to Orders</a></p>'
    return admin_page('Order Detail', body)

@app.route('/admin/transactions')
@admin_required
def admin_transactions():
    conn = get_db()
    txns = conn.execute("SELECT t.*, u.name, u.phone FROM transactions t LEFT JOIN users u ON u.id=t.user_id ORDER BY t.id DESC LIMIT 100").fetchall(); conn.close()
    rows = ''
    for t in txns:
        cls = 'b-in' if t['type'] in ('TOPUP','RECEIVE') else 'b-out'
        rows += f'<tr><td>{t["id"]}</td><td>{t["name"] or "-"}<br><span style="color:#8e8e93;font-size:12px">{t["phone"] or ""}</span></td><td><span class="badge {cls}">{t["type"]}</span></td><td><b style="color:#ff3b30">{t["amount"]:,.0f} Ks</b></td><td>{t["note"] or "-"}</td><td>{t["created_at"][:16]}</td></tr>'
    body = f'<div class="admin-table"><table><thead><tr><th>ID</th><th>User</th><th>Type</th><th>Amount</th><th>Note</th><th>Date</th></tr></thead><tbody>{rows or "<tr><td colspan=6 style='text-align:center;padding:40px;color:#c7c7cc'>No data</td></tr>"}</tbody></table></div>'
    return admin_page('Transactions', body)

